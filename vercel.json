{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/paper/(.*)",
      "dest": "/frontend/paper.html"
    },
    {
      "src": "/graph",
      "dest": "/frontend/graph.html"
    },
    {
      "src": "/status",
      "dest": "/frontend/status.html"
    },
    {
      "src": "/test-add",
      "dest": "/frontend/test_add_paper.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
