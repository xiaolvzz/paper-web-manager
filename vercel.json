{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/paper/:id",
      "destination": "/frontend/paper.html"
    },
    {
      "source": "/graph",
      "destination": "/frontend/graph.html"
    },
    {
      "source": "/status",
      "destination": "/frontend/status.html"
    },
    {
      "source": "/test-add",
      "destination": "/frontend/test_add_paper.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
